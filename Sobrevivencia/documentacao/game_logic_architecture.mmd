%%  LEGENDA DE ÍCONES (usados nos labels):
%%    [GL]  GameLogic Base
%%    [CM]  Combat Manager
%%    [EM]  Enemy Manager
%%    [IM]  Item Manager
%%    [QM]  Quest Manager
%%    [BA]  Buff Applicator
%%
